{
  "name": "@sociobot/replay-capsule",
  "version": "0.1.0",
  "description": "Tiny deterministic input-and-seed replay files for browser games",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist/index.js",
    "dist/index.cjs",
    "dist/index.d.ts",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "dev": "vite --config vite.site.config.ts",
    "build": "npm run clean && npm run build:lib && npm run build:site",
    "build:lib": "tsup src/index.ts --format esm,cjs --dts --target es2022 --clean=false",
    "build:site": "vite build --config vite.site.config.ts",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage=false",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm test && npm run build && npm run test:e2e"
  },
  "keywords": [
    "browser-game",
    "replay",
    "canvas",
    "phaser",
    "kaplay",
    "debugging"
  ],
  "author": "Sociobot (Param Factory)",
  "license": "MIT",
  "homepage": "https://browser-game-replay-capsule.sociobot.in",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/B-Divyesh/sf-browser-game-replay-capsule.git"
  },
  "bugs": "https://github.com/B-Divyesh/sf-browser-game-replay-capsule/issues",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@fontsource/atkinson-hyperlegible": "5.2.6",
    "@fontsource/space-mono": "5.2.6",
    "@playwright/test": "1.58.2",
    "@types/node": "24.3.0",
    "tsup": "8.5.0",
    "typescript": "5.9.2",
    "vite": "7.3.6",
    "vitest": "3.2.7"
  }
}
